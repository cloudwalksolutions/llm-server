**/.claude
**/.DS_Store

# Secrets: .env holds LLAMA_API_KEY and SSH_PASS.
# The glob matters — timestamped backups leak the same values.
.env
.env.*
*.env.bak*

# Benchmark runs are transient; bench/baseline.json is committed on purpose
# so an accepted perf trade shows up as a reviewable diff.
bench/*.json
!bench/baseline.json
# Same reasoning for the agent-workload baseline: accepting a new one is a
# deliberate trade, so it should show up as a reviewable diff.
!bench/agent-baseline.json

# Config backups pulled down from a target
*.conf.backup.*
*.conf.bak.*
*.service.backup.*
